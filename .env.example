# Roboflow API key — required to ingest a dataset from Roboflow Universe.
# Free: roboflow.com → Settings → API Keys. Public datasets still need one.
# Copy this file to .env.local and fill it in.
ROBOFLOW_API_KEY=

# Where ingested datasets are cached. Defaults to ./.roboflow-cache locally and
# /tmp/roboflow-cache on Vercel, where the deployment directory is read-only.
# ROBOFLOW_CACHE_DIR=

# Vercel Blob store, set automatically once a store is connected to the project.
# A finished library is uploaded as one zip (not one file per thumbnail). Local
# ingests skip this unless the token is set.
# BLOB_READ_WRITE_TOKEN=
